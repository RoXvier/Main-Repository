2\u0006\u0002\n\u0000R\u000f\u0010\u0095\u0003\u001a\u00020\"X\u0082\u000e\u00a2\u0006\u0002\n\u0000R%\u0010\u0096\u0003\u001a\u0018\u0012\u0005\u0012\u00030\u0096\u0001\u0012\u0004\u0012\u00020\"\u0012\u0004\u0012\u00020A\u0018\u00010\u00db\u0002X\u0082\u000e\u00a2\u0006\u0002\n\u0000RX\u0010\u0097\u0003\u001a\u0016\u0012\u0005\u0012\u00030\u0096\u0001\u0012\u0004\u0012\u00020\"\u0012\u0004\u0012\u00020A0\u00db\u00022\u001a\u0010\u001b\u001a\u0016\u0012\u0005\u0012\u00030\u0096\u0001\u0012\u0004\u0012\u00020\"\u0012\u0004\u0012\u00020A0\u00db\u00028@@@X\u0081\u000e\u00a2\u0006\u0017\u0012\u0005\u0008\u0098\u0003\u0010&\u001a\u0006\u0008\u0099\u0003\u0010\u009a\u0003\"\u0006\u0008\u009b\u0003\u0010\u009c\u0003R\u0010\u0010\u009d\u0003\u001a\u00030\u009e\u0003X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u0015\u0010\u009f\u0003\u001a\u0008\u0012\u0004\u0012\u00020A0[X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u0015\u0010\u00a0\u0003\u001a\u0008\u0012\u0004\u0012\u00020A0[X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u000f\u0010\u00a1\u0003\u001a\u00020\"X\u0082\u000e\u00a2\u0006\u0002\n\u0000R\u001e\u0010\u00a2\u0003\u001a\u00020\"X\u0080\u000e\u00a2\u0006\u0011\n\u0000\u001a\u0005\u0008\u00a3\u0003\u0010m\"\u0006\u0008\u00a4\u0003\u0010\u008d\u0001R\u000f\u0010\u00a5\u0003\u001a\u00020\"X\u0082\u000e\u00a2\u0006\u0002\n\u0000R\u0012\u0010\u00b2\u0003\u001a\u0005\u0018\u00010\u00b3\u0003X\u0082\u0004\u00a2\u0006\u0002\n\u0000R\u0013\u0010\u00b4\u0003\u001a\u00020\"8F\u00a2\u0006\u0007\u001a\u0005\u0008\u00b5\u0003\u0010mR\u0011\u0010\u00b5\u0004\u001a\u0004\u0018\u000100X\u0082\u000e\u00a2\u0006\u0002\n\u0000R\u0018\u0010\u00af\u0005\u001a\u00030\u00b0\u0005X\u0096\u0004\u00a2\u0006\n\n\u0000\u001a\u0006\u0008\u00b1\u0005\u0010\u00b2\u0005R\u0018\u0010\u00b3\u0005\u001a\u00030\u00b4\u00058VX\u0096\u0004\u00a2\u0006\u0008\u001a\u0006\u0008\u00b5\u0005\u0010\u00b6\u0005R\u0016\u0010\u00b9\u0005\u001a\u00020\"8VX\u0096\u0004\u00a2\u0006\u0007\u001a\u0005\u0008\u00b9\u0005\u0010mR\u0